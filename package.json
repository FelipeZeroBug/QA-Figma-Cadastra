{
  "name": "qa-figma-cadastra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automação local de QA visual para comparar prévias completas do Figma com páginas desenvolvidas.",
  "scripts": {
    "qa": "tsx src/cli/qa.ts",
    "qa:demo": "tsx src/cli/demo.ts",
    "report:pdf": "tsx src/cli/pdf-report.ts",
    "report:reanalyze": "tsx src/cli/reanalyze-report.ts",
    "auth:figma": "tsx src/cli/auth.ts figma",
    "figma:check": "tsx src/cli/figma-check.ts",
    "auth:ws": "tsx src/cli/auth.ts workspace",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@inquirer/prompts": "^8.0.1",
    "chalk": "^5.6.2",
    "open": "^10.2.0",
    "pdfkit": "^0.20.2",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.55.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "slugify": "^1.6.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.36.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.2"
  }
}
